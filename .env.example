# DQI (Deriv Quant Intelligence) Environment Configuration
# Copy to .env locally or configure in Vercel Project Environment Variables.
# NEVER commit real secrets or expose server secrets through VITE_* variables.

# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
QUANT_SITE_URL=http://localhost:3000
QUANT_ALLOWED_ORIGINS=http://localhost:3000

# Neon PostgreSQL (DATABASE_URL = pooled connection, DATABASE_URL_UNPOOLED = direct migrations connection)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Deriv OAuth 2.0 + Market API
# Register exact callback URL in your Deriv developer app.
DERIV_CLIENT_ID=
DERIV_APP_ID=1089
DERIV_REDIRECT_URI=http://localhost:3000/api/v1/auth/deriv/callback
DERIV_OAUTH_SCOPES=read trade
DERIV_API_BASE_URL=https://api.derivws.com
DERIV_AUTH_BASE_URL=https://auth.deriv.com
DERIV_PUBLIC_WS_URL=wss://ws.derivws.com/websockets/v3

# Cryptographic Keys (leave empty locally to auto-generate ephemeral dev keys; set 32-byte secrets in production)
DQI_ENCRYPTION_KEY_BASE64=
DQI_SESSION_SECRET=
QUANT_SESSION_SECRET=
QUANT_ADMIN_PASSWORD_HASH=
QUANT_SESSION_TTL_SECONDS=28800
QUANT_COOKIE_SECURE=false

# Scheduled Cron (Vercel Cron Bearer authorization)
CRON_SECRET=

# Controlled Live Execution & Bounded Recovery Safety Gates (OFF by default — NEVER enable without demo validation)
DQI_LIVE_TRADING_ENABLED=false
DQI_LIVE_MAX_STAKE=1
DQI_LIVE_MAX_DAILY_LOSS=5
DQI_RECOVERY_ENABLED=false
DQI_MAX_RECOVERY_ATTEMPTS=0
DQI_MAX_STAKE=1
DQI_MAX_SESSION_LOSS=5
DQI_MAX_DAILY_LOSS=5
DQI_MAX_DRAWDOWN_PERCENT=5
